# Application Environment
# Options: local | development | production
# PENTING: admin/setup.php (untuk mengatur password admin awal) HANYA berjalan
# jika APP_ENV di-set ke "local" atau "development". Di server produksi,
# biarkan "production" (atau hapus baris ini) supaya setup.php otomatis TIDAK
# bisa diakses.
APP_ENV=local

# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=sma_putra_persada
DB_USER=root
# PENTING: gunakan password yang kuat & unik di server produksi (jangan dikosongkan).
DB_PASS=
DB_CHARSET=utf8mb4
